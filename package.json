    "og": "node tools/render-og.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  }
}